# ─────────────────────────────────────────────────────────────
# Carbide India WMS — environment variables
# Copy to .env.local for development. Production values live in
# the Vercel project's Environment Variables UI.
# ─────────────────────────────────────────────────────────────

# ── DATABASE (required) — Neon Postgres, POOLED url ─────────
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# ── CLERK AUTH (required) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ── IP GATE (required in production) ─────────────────────────
# Comma-separated allowlist. EMPTY = gate disabled (dev).
# Example: ALLOWED_IPS="103.x.x.x,49.x.x.x"
ALLOWED_IPS=""

# ── FILE STORAGE (required) — Vercel Blob ────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── APP (required) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://wms.carbideindia.com"

# ── EMAIL (optional) ─────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Carbide India WMS <onboarding@resend.dev>"

# ── WEB PUSH (optional) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sales1@carbideindia.com"

# ── CRON (required for /api/cron/*) ──────────────────────────
CRON_SECRET=""

# ── GST LOOKUP (optional) — GSTIN → business details autofill ─
# Powers the "Fetch" button on the Client KYC GSTIN field.
# Default provider: Sandbox (sandbox.co.in), 2-step auth.
KYB_PROVIDER="sandbox"
SANDBOX_API_KEY=""
SANDBOX_API_SECRET=""
# Optional overrides: SANDBOX_BASE_URL (default https://api.sandbox.co.in),
# SANDBOX_API_VERSION (default 1.0).
#
# To use a different provider instead, unset KYB_PROVIDER and set:
#   KYB_GST_URL, KYB_API_KEY  (see lib/kyb/gst-lookup.ts for all KYB_* knobs)

# ── OBSERVABILITY (optional) ─────────────────────────────────
SLOW_QUERY_MS="300"
NEXT_PUBLIC_SENTRY_DSN=""
