# ─────────────────────────────────────────────────────────────
# Carbide India WMS — environment variables
# Copy to .env.local for development. Production values live in
# the Vercel project's Environment Variables UI.
# ─────────────────────────────────────────────────────────────

# ── DATABASE (required) — Neon Postgres, POOLED url ─────────
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# ── CLERK AUTH (required) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ── FIREBASE AUTH (migration in progress — Phase F1) ─────────
# Public client config (browser). Project: carbide-india-1.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# Admin service-account (secret, server only). Private key keeps its literal
# "\n" escapes — the admin SDK normalizes them at runtime.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── IP GATE (required in production) ─────────────────────────
# Comma-separated allowlist. EMPTY = gate disabled (dev).
# Example: ALLOWED_IPS="103.x.x.x,49.x.x.x"
ALLOWED_IPS=""

# ── FILE STORAGE (required) — Vercel Blob ────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── APP (required) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://wms.carbideindia.com"

# ── EMAIL (optional) ─────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Carbide India WMS <onboarding@resend.dev>"

# ── WEB PUSH (optional) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sales1@carbideindia.com"

# ── CRON (required for /api/cron/*) ──────────────────────────
CRON_SECRET=""

# ── OBSERVABILITY (optional) ─────────────────────────────────
SLOW_QUERY_MS="300"
NEXT_PUBLIC_SENTRY_DSN=""
